# Clave de API de Anthropic (Claude). Obtenla en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Clave de API de PageIndex. Obtenla en https://dash.pageindex.ai/api-keys
PAGEINDEX_API_KEY=pi-...

# (Opcional) Modelo de Claude a usar. Por defecto: claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# (Opcional) Nombre de la carpeta del baúl en PageIndex. Por defecto: contract-diff-baul
PAGEINDEX_FOLDER_NAME=contract-diff-baul

# (Opcional) ID de carpeta existente si tu plan incluye folders en PageIndex
# PAGEINDEX_FOLDER_ID=
